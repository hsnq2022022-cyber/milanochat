+        { method: "POST" }
+      )
+        .then((r) => {
+          const fresh = r?.ok ? r.avatarUrl : null;
+          if (!fresh) return;
+          unbreak(fresh);
+          const patch = { avatar_url: fresh, avatarUrl: fresh };
+          setChAccounts((prev) => prev.map((a) => (a.id === id ? { ...a, ...patch } : a)));
+          setManageAcc((prev) => (prev && prev.id === id ? { ...prev, ...patch } : prev));
+        })
+        .catch(() => {});
+    }
+  };
