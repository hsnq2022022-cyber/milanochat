+      /* ═══════════════════════════════════════════════════════════════
+         تجديد الصور — تُستدعى من الواجهة فقط بعد فشل تحميل صورة فعلياً.
+         روابط CDN المُعادة من Meta مؤقتة (تنتهي خلال أيام)، فنعيد جلب
+         رابط جديد من Graph API بنفس رمز الحساب المخزّن. لا نستبدل قيمة
+         موجودة بـ NULL، ولا نسجّل الرموز.
+      ═══════════════════════════════════════════════════════════════ */
+
+      case "refresh_customer_avatar": {
+        const convId = String(body.convId ?? "").trim();
+        if (!convId) return err("convId مطلوب");
+
+        const { data: conv } = await sb
+          .from("conversations")
+          .select("id, wa_chat_id, channel, account_id")
+          .eq("id", convId)
+          .eq("tenant_id", tenant.id)
+          .maybeSingle();
+
+        if (!conv) return err("المحادثة غير موجودة", 404);
+
+        const convChannel =
+          conv.channel === "instagram" || conv.channel === "facebook"
+            ? (conv.channel as "instagram" | "facebook")
+            : null;
+        const senderId = String(conv.wa_chat_id ?? "").replace(
+          /^(instagram|facebook):/,
+          ""
+        );
+
+        if (!convChannel || !conv.account_id || !senderId) {
+          return json({ ok: false, avatar: null, reason: "unsupported" });
+        }
+
+        const { data: acc } = await sb
+          .from("channel_accounts")
+          .select("access_token_encrypted")
+          .eq("id", conv.account_id)
+          .eq("tenant_id", tenant.id)
+          .maybeSingle();
+
+        let tok: string | null = null;
+        try {
+          tok = acc?.access_token_encrypted
+            ? await decryptField(acc.access_token_encrypted)
+            : null;
+        } catch {
+          tok = null;
+        }
+
+        const prof = await fetchSenderProfile({
+          channel: convChannel,
+          senderId,
+          token: tok,
+        });
+
+        if (prof.avatar && /^https?:\/\//i.test(prof.avatar)) {
+          const { error: upErr } = await sb
+            .from("conversations")
+            .update({ customer_avatar: prof.avatar })
+            .eq("id", conv.id)
+            .eq("tenant_id", tenant.id);
+
+          if (upErr) {
+            console.error("[refresh_customer_avatar] update failed:", upErr.message);
+            return json({ ok: false, avatar: null, reason: "db_error" });
+          }
+          return json({ ok: true, avatar: prof.avatar });
+        }
+
+        return json({ ok: false, avatar: null, reason: "unavailable" });
+      }
+
+      case "refresh_account_avatar": {
+        const accountId = String(body.accountId ?? "").trim();
+        if (!accountId) return err("accountId مطلوب");
+
+        const { data: acc } = await sb
+          .from("channel_accounts")
+          .select("id, channel, access_token_encrypted")
+          .eq("id", accountId)
+          .eq("tenant_id", tenant.id)
+          .maybeSingle();
+
+        if (!acc) return err("الحساب غير موجود", 404);
+
+        // نفس نداء /me المستخدم أصلاً عند ربط الحساب في meta-auth (Instagram Login)
+        if (acc.channel !== "instagram" || !acc.access_token_encrypted) {
+          return json({ ok: false, avatarUrl: null, reason: "unsupported" });
+        }
+
+        let tok = "";
+        try {
+          tok = await decryptField(acc.access_token_encrypted);
+        } catch {
+          tok = "";
+        }
+        if (!tok) {
+          return json({ ok: false, avatarUrl: null, reason: "token_unavailable" });
+        }
+
+        try {
+          const r = await fetch(
+            `https://graph.instagram.com/v21.0/me?fields=profile_picture_url&access_token=${encodeURIComponent(tok)}`
+          );
+          if (!r.ok) {
+            // نسجّل رمز الحالة فقط — الرابط يحوي التوكن فلا نطبعه
+            console.warn(`[refresh_account_avatar] HTTP ${r.status}`);
+            return json({ ok: false, avatarUrl: null, reason: "graph_error" });
+          }
+          const pj: any = await r.json().catch(() => ({}));
+          const url: string | null =
+            typeof pj?.profile_picture_url === "string" &&
+            /^https?:\/\//i.test(pj.profile_picture_url)
+              ? pj.profile_picture_url
+              : null;
+
+          if (!url) {
+            return json({ ok: false, avatarUrl: null, reason: "unavailable" });
+          }
+
+          const now = new Date().toISOString();
+          const { error: upErr } = await sb
+            .from("channel_accounts")
+            .update({ avatar_url: url, last_sync_at: now, updated_at: now })
+            .eq("id", acc.id)
+            .eq("tenant_id", tenant.id);
+
+          if (upErr) {
+            console.error("[refresh_account_avatar] update failed:", upErr.message);
+            return json({ ok: false, avatarUrl: null, reason: "db_error" });
+          }
+          return json({ ok: true, avatarUrl: url });
+        } catch (e: any) {
+          console.warn("[refresh_account_avatar] error:", e?.message ?? e);
+          return json({ ok: false, avatarUrl: null, reason: "network" });
+        }
+      }
