```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
target/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py.class
.Python
env/
venv/
.venv/
.ENV
.python-version
.pytest_cache/
.mypy_cache/
.coverage
coverage/
htmlcov/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Coverage
coverage/
.nyc_output/
istanbul/
*.lcov

# Distribution / packaging
*.tar.gz
*.zip
*.rar
*.7z

# Compiled Binary files
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.a
*.lib
*.out

# Compression
*.gz
*.bz2
*.xz
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar
*.tgz
*.tar.bz2
*.tar.xz
*.tar.zst
