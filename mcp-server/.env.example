# Required. Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Required. SERVICE ROLE key: bypasses Row Level Security. Keep it secret, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Storage adapter:
#   columns (default) -> table with columns id, tenant_id, name, nodes, edges, created_at, updated_at
#   drafts            -> the Flow Builder's real cloud-draft table public.automation_flow_drafts
#                        (tenant_id, flow_key, name, document{version:3,name,nodes,edges}, draft_revision, ...)
MILANO_FLOWS_STORAGE=columns
# Optional. Table name. Default: automation_flows (columns) / automation_flow_drafts (drafts).
MILANO_FLOWS_TABLE=automation_flows
# Optional but STRONGLY recommended. Locks this server to one tenant (uuid).
MILANO_ALLOWED_TENANT_ID=

# ---- Remote HTTP server only (npm run dev:http / start:http); stdio ignores these ----
# Port to listen on (default 8080).
PORT=8080
# Supabase project JWT secret (Settings -> API -> JWT secret), >= 32 chars. Keep it secret.
# Required only when MCP_ALLOW_STATIC_BEARER is on (verifies Supabase user access tokens sent as Bearer).
SUPABASE_JWT_SECRET=
# Static Supabase-JWT Bearer fallback. Default: false when NODE_ENV=production, true elsewhere.
MCP_ALLOW_STATIC_BEARER=
# TESTING ONLY. true = accept requests without a token, tenant taken from the X-Milano-Tenant header.
# The server refuses to start with this set to true when NODE_ENV=production.
MCP_ALLOW_SECRET_HEADER=false
# Express "trust proxy": false (default, direct exposure) or the number of proxy hops in front
# of the server (1 behind ngrok or Railway). Needed so rate limiting sees the real client IP.
TRUST_PROXY=false
# Set NODE_ENV=production on deployed servers (blocks MCP_ALLOW_SECRET_HEADER=true and
# MCP_INSECURE_COOKIES=true, requires DATABASE_URL with OAuth, turns MCP_ALLOW_STATIC_BEARER off by default).
NODE_ENV=

# ---- OAuth 2.1 for web connectors (Claude.ai / ChatGPT / Cursor). HTTP server only ----
# true = enable /.well-known/*, /register, /authorize, /consent, /token, /revoke and OAuth access tokens on /mcp.
MCP_OAUTH_ENABLED=false
# Required with OAuth. Public origin of this server, no path (issuer). https required
# (http only for localhost / 127.0.0.1 outside production). e.g. https://abcd-1-2-3-4.ngrok-free.app
MCP_PUBLIC_URL=
# Required with OAuth. HS256 key for OAuth access tokens, >= 32 random chars, DIFFERENT from
# SUPABASE_JWT_SECRET. Generate: openssl rand -base64 48
MCP_OAUTH_SIGNING_SECRET=
# Required with OAuth. express-session secret for the login/consent pages, >= 32 random chars.
SESSION_SECRET=
# Required with OAuth. Supabase anon (public) key: used server-side for the password login only.
SUPABASE_ANON_KEY=
# Required with OAuth when NODE_ENV=production. Supabase Postgres connection string (owner/postgres user;
# session pooler or direct). Without it an IN-MEMORY store is used: LOCAL DEVELOPMENT ONLY.
# Apply supabase/migrations/20261029320000_oauth_tables.sql first.
DATABASE_URL=
# TLS for DATABASE_URL: verify (default) | no-verify (encrypted, certificate NOT checked) | disable (local host only).
DATABASE_SSL=verify
# PEM CA file for DATABASE_SSL=verify (Supabase: Database settings -> SSL configuration -> download certificate).
DATABASE_SSL_CA_FILE=
# Dynamic Client Registration cap (registrations per hour, all clients). Default 100.
MCP_OAUTH_MAX_CLIENTS_PER_HOUR=100
# LOCAL http DEV ONLY: send the session cookie without the Secure flag (refused when NODE_ENV=production).
MCP_INSECURE_COOKIES=false
