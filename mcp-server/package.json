{
  "name": "milanochat-flows-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server (stdio) for creating and editing Milanochat automation flows",
  "type": "module",
  "bin": {
    "milanochat-flows-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
