# ─── أنماط تشغيل واجهة ميلانو (تلقائي حسب المتغيرات) ───
#
# النمط الوحيد المعتمد الآن — supabase: كل شيء على Supabase Edge Functions
#   (واتساب عبر Cloud API الرسمية، القنوات عبر دالة channels، الـ callback عبر meta-auth)
#   خادم Railway القديم أُغلق وحُذف نهائيًا — لم يعد VITE_API_URL يُقرأ من أي مكان.
#
# وضع احتياطي — demo: اترك المتغيرات فارغة → وضع العرض التجريبي بدون خادم.

# رابط دوال Supabase Edge Functions (اختياري — إن تُرك فارغًا يُشتق تلقائيًا من VITE_SUPABASE_URL):
VITE_SUPABASE_FUNCTIONS_URL=https://nmhefwvhoholcjrbbila.supabase.co/functions/v1

# متغيرات Supabase الأساسية:
VITE_SUPABASE_URL=https://nmhefwvhoholcjrbbila.supabase.co
VITE_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>

# بعد أي تغيير هنا أعد البناء والنشر:
# npm run build && npx gh-pages -d dist
